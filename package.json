{
  "name": "reachinbox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/worker\" \"npm run dev --workspace=apps/frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=apps/backend",
    "test:web": "npm run test --workspace=apps/frontend",
    "test:e2e": "npm run test --workspace=e2e",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "5.3.3"
  }
}


