# Production environment variables for Render
# Never commit real values

# --- Auto-provided by Render ---
DATABASE_URL=         # Auto-linked from Render PostgreSQL
REDIS_URL=            # Auto-linked from Render Redis
PORT=                 # Auto-set by Render (do not set manually)

# --- Generate these ---
SESSION_SECRET=       # Random 32+ char string: openssl rand -hex 32
ENCRYPTION_KEY=       # Random 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Backend service URL (set after backend deploys) ---
CORS_ORIGIN=          # https://reachinbox-frontend.onrender.com
NEXT_PUBLIC_API_URL=  # https://reachinbox-backend.onrender.com

# --- Google OAuth (update callback URL in Google Console) ---
GOOGLE_CLIENT_ID=     # From Google Cloud Console
GOOGLE_CLIENT_SECRET= # From Google Cloud Console
GOOGLE_CALLBACK_URL=  # https://reachinbox-backend.onrender.com/api/auth/google/callback

# --- Slack OAuth (update redirect URL in Slack App settings) ---
SLACK_CLIENT_ID=      # From api.slack.com/apps
SLACK_CLIENT_SECRET=  # From api.slack.com/apps
SLACK_REDIRECT_URI=   # https://reachinbox-backend.onrender.com/api/slack/callback

# --- Optional ---
ELASTICSEARCH_URL=    # Leave empty to use degraded DB search
ADMIN_EMAIL=          # Your email for Bull Board admin access
GLOBAL_HOURLY_LIMIT=100
SENDER_HOURLY_LIMIT=50
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
NODE_ENV=production
